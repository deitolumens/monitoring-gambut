# ──────────────────────────────────────────────────
# Supabase Configuration
# ──────────────────────────────────────────────────

# Supabase project URL (from Supabase dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (server-side only, NEVER expose to browser)
SUPABASE_SERVICE_KEY=your-service-role-key

# Supabase Anonymous/Public Key (safe for browser)
SUPABASE_ANON_KEY=your-anon-key

# ──────────────────────────────────────────────────
# MQTT Broker (HiveMQ Cloud)
# ──────────────────────────────────────────────────
MQTT_URL=wss://5983d80f70534c6b89c3343d2a478e3a.s1.eu.hivemq.cloud:8884
MQTT_USERNAME=your_hivemq_username
MQTT_PASSWORD=your_hivemq_password
MQTT_TOPIC=peatland/+/data
MQTT_REJECT_UNAUTHORIZED=true

# Optional browser MQTT diagnostic. These values are exposed to the browser;
# use a read-only MQTT user and never put Supabase service keys here.
NEXT_PUBLIC_MQTT_URL=wss://5983d80f70534c6b89c3343d2a478e3a.s1.eu.hivemq.cloud:8884/mqtt
NEXT_PUBLIC_MQTT_USERNAME=read_only_mqtt_user
NEXT_PUBLIC_MQTT_PASSWORD=read_only_mqtt_password
NEXT_PUBLIC_MQTT_TOPIC=peatland/+/data
