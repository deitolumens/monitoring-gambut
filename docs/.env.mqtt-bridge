# ──────────────────────────────────────────────────
# MQTT Broker (HiveMQ Cloud)
# ──────────────────────────────────────────────────
# WSS endpoint — note the wss:// protocol for secure WebSocket
MQTT_URL=wss://5983d80f70534c6b89c3343d2a478e3a.s1.eu.hivemq.cloud:8884
MQTT_USERNAME=your_hivemq_username
MQTT_PASSWORD=your_hivemq_password

# Topic to subscribe to. The + wildcard matches any single level,
# so "peatland/+/data" catches messages from all nodes (A, B, C).
MQTT_TOPIC=peatland/+/data

# Set to "false" only if your broker uses a self-signed certificate
# and you need to bypass validation during development.
MQTT_REJECT_UNAUTHORIZED=true

# ──────────────────────────────────────────────────
# Neon.tech PostgreSQL Database
# ──────────────────────────────────────────────────
# Connection string from your Neon.tech dashboard.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/peatland?sslmode=require

# ──────────────────────────────────────────────────
# Optional: Dashboard Frontend (Next.js)
# ──────────────────────────────────────────────────
# If you want the Next.js dashboard to query Neon directly
# instead of through the bridge, set this as a server-side
# variable (do NOT prefix with NEXT_PUBLIC_).
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/peatland?sslmode=require
